# ─────────────────────────────────────────────────────────────────────────
# Financial RAG — environment template (docker compose)
#
#   cp .env.example .env
#
# docker compose reads .env for ${VAR:-...} interpolation and injects it
# into the backend service. Infra topology (mongo/redis/qdrant/mlflow DNS
# names) is hardcoded in docker-compose.yml and wins over any legacy keys
# below. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────

# ── API keys (required for generation; LLAMA_CLOUD is optional) ─────────
GROQ_API_KEY=change-me-your-groq-key
LLAMA_CLOUD_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-long-random-secret
SUPERADMIN_EMAIL=admin@financial-rag.local
SUPERADMIN_PASSWORD=change-me-strong-password
# Seed the admin account on first backend start (matches app default true).
SEED_SUPERADMIN=true

# ── Public URL baked into the frontend build (browser reaches the API) ──
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Datastore / service topology ─────────────────────────────────────────
# These are set by docker-compose.yml to the container service names and
# generally should NOT be overridden here. Listed for documentation only.
# MONGODB_URI=mongodb://mongo:27017/financial_rag
# MONGODB_DB=financial_rag
# REDIS_URL=redis://redis:6379/0
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_PATH=            # empty -> Qdrant remote-server mode
# QDRANT_COLLECTION=financial_vectors
# MLFLOW_EVAL_REGISTRY_URI=http://mlflow:5000
# MLFLOW_TRACKING_URI=http://mlflow:5000
# DATA_DIR=/app/data
# LOG_DIR=/app/logs

# ── Model / retrieval behavior (all optional; app defaults shown) ───────
# RERANKER_DTYPE=float16
# HYBRID_TOP_K=40
# RERANKER_CLASSNAME=NomicReranker
# USE_ARQ_QUEUE=false
# RATE_LIMIT_ENABLED=true

# ── Legacy keys still honored by config/settings.py (not used by compose) ─
# MONGO_URI=127.0.0.1:27017
# MONGO_DB_NAME=financial_rag
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379